# Database
DB_PATH=./chitragupta.db

# Storage
STORAGE_DIR=./storage

# Encryption (generate with: openssl rand -base64 32)
MASTER_KEY=

# JWT (generate with: openssl rand -base64 48)
JWT_SECRET=

# JWT token expiration in minutes
JWT_EXPIRE_MINUTES=60

# Maximum upload size in MB
MAX_UPLOAD_MB=100

# Vault (Obsidian bridge)
VAULT_DIR=./vault
VAULT_TEMPLATE_GRAPH=./vault_template/graph.json
VAULT_AUTOSYNC=1
VAULT_POLL_SECONDS=2

# LLM (Skeptic agent)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Investigation (contradiction detector)
INVESTIGATION_MAX_TRAVEL_MINUTES=15
ALLOW_DEMO_IMPORT=0